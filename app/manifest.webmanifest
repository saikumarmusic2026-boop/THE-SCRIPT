{
  "id": "./",
  "name": "THE SCRIPT - Screenplay Editor",
  "short_name": "THE SCRIPT",
  "description": "Screenplay editor with storyboard and PDF export",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e6e3dc",
  "theme_color": "#f3f1ec",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "productivity",
    "utilities"
  ],
  "orientation": "any",
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "application/json": [
          ".thescript"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        {
          "name": "project",
          "accept": [
            "application/json",
            "application/octet-stream",
            "text/plain",
            ".thescript"
          ]
        }
      ]
    }
  }
}
